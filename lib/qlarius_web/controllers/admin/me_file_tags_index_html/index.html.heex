<div class="flex h-screen">
  <AdminSidebar.sidebar current_user={@current_scope.user} current_path={@current_path} />
  <div class="flex min-w-0 grow flex-col">
    <AdminTopbar.topbar current_user={@current_scope.user} />
    <div class="overflow-auto">
      <.page>
        <.page_header title="MeFile tags map" subtitle={"JSON for MeFile ##{@me_file_id}"}>
          <:actions>
            <.copy_json_button target_id="mefile-tags-index-json" />
          </:actions>
        </.page_header>

        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
          <form method="get" action={~p"/admin/mefile_tags_index"} class="flex items-center gap-2">
            <label class="input input-sm w-48">
              <.icon name="hero-identification" class="size-4 text-base-content/50" />
              <input
                type="number"
                name="me_file_id"
                value={@me_file_id}
                placeholder="MeFile ID"
                aria-label="MeFile ID"
                class="grow"
              />
            </label>
            <button type="submit" class="btn btn-sm">Inspect</button>
          </form>
          <p class="text-sm text-base-content/60">
            Output of <code class="text-xs">MeFiles.me_file_tag_map_by_category_trait_tag/1</code>:
            categories → parent traits → tags.
          </p>
        </div>

        <.panel flush>
          <div class="overflow-x-auto px-6 py-4">
            <pre
              id="mefile-tags-index-json"
              class="cursor-text select-all whitespace-pre-wrap font-mono text-sm"
            ><%= @json_string %></pre>
          </div>
        </.panel>
      </.page>
    </div>
  </div>
</div>
