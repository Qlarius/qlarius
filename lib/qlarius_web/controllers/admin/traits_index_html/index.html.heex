<div class="flex h-screen">
  <AdminSidebar.sidebar current_user={@current_scope.user} current_path={@current_path} />
  <div class="flex min-w-0 grow flex-col">
    <AdminTopbar.topbar current_user={@current_scope.user} />
    <div class="overflow-auto">
      <.page>
        <.page_header
          title="Traits index"
          subtitle="Target building reference. Traits by category (display_order asc), each with parent traits (display_order asc) and child traits (display_order asc)."
        >
          <:actions>
            <.copy_json_button target_id="traits-index-json" />
          </:actions>
        </.page_header>

        <.panel flush title="JSON" description="Copy the JSON below for reference.">
          <div class="overflow-x-auto px-6 py-4">
            <pre
              id="traits-index-json"
              class="cursor-text select-all whitespace-pre-wrap font-mono text-sm"
            ><%= @json_string %></pre>
          </div>
        </.panel>
      </.page>
    </div>
  </div>
</div>
