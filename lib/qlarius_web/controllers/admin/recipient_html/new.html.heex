<div class="flex h-screen">
  <AdminSidebar.sidebar current_user={@current_scope.user} current_path={@current_path} />
  <div class="flex min-w-0 grow flex-col">
    <AdminTopbar.topbar current_user={@current_scope.user} />
    <div class="overflow-auto">
      <.page class="max-w-3xl">
        <.page_header
          title="New recipient"
          subtitle="Create a new recipient."
          back_to={~p"/admin/recipients"}
          back_label="Recipients"
        />

        <.recipient_form
          changeset={@changeset}
          action={~p"/admin/recipients"}
          method="post"
          submit_label="Create recipient"
        />
      </.page>
    </div>
  </div>
</div>
