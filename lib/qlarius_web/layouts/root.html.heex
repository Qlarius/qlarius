<!DOCTYPE html>
<html
  lang="en"
  class={["[scrollbar-gutter:stable]", assigns[:embed_document] && "embed-document"]}
  data-theme={document_theme(assigns)}
  data-theme-mode={document_theme_mode(assigns)}
>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="color-scheme"
      content={
        case document_theme(assigns) do
          "dark" -> "dark"
          "light" -> "light"
          _ -> "light dark"
        end
      }
    />
    <%= if document_theme(assigns) in ["light", "dark"] do %>
      <meta
        name="theme-color"
        content={if document_theme(assigns) == "dark", do: "#000000", else: "#f3f4f6"}
      />
    <% else %>
      <meta name="theme-color" content="#f3f4f6" media="(prefers-color-scheme: light)" />
      <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <% end %>
    <meta name="application-name" content="Qadabra" />
    <meta name="apple-mobile-web-app-title" content="Qadabra" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%= if assigns[:embed_document] do %>
      <meta name="widget-socket" content="/widgets/live" />
      <meta
        name="widget-token"
        content={QlariusWeb.Auth.WidgetToken.sign_anon(assigns[:session_sync_id])}
      />
    <% end %>
    <meta
      name="qadabra-extension-ids"
      content={
        Application.get_env(:qlarius, :cors_extension_ids, [])
        |> Enum.map(fn
          "chrome-extension://" <> id -> id
          id when is_binary(id) -> id
          _ -> nil
        end)
        |> Enum.reject(&is_nil/1)
        |> Enum.join(",")
      }
    />
    <link rel="icon" type="image/png" href="/images/favicon.png" sizes="32x32" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/qlarius_app_icon_180.png" />
    <link rel="manifest" href={~p"/app-manifest.webmanifest"} />
    <%!-- Omit live_title `default` so a missing join `t` does not overwrite SSR title. --%>
    <.live_title>
      {assigns[:page_title] || "Qadabra"}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        // iOS standalone PWA: flag before first paint so bottom nav skips double safe-area inset
        const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
        const isPWA =
          window.matchMedia("(display-mode: standalone)").matches ||
          window.navigator.standalone === true;
        if (isIOS && isPWA) {
          document.documentElement.classList.add("ios-pwa");
          // Letterbox: status bar is outside the page (top inset 0, and the
          // screen is taller than the layout viewport). An icon saved with
          // black-translucent still has a top inset, so it stays on the old spacing.
          const syncIosPwaLetterbox = () => {
            const probe = document.createElement("div");
            probe.style.cssText = "position:fixed;top:0;left:0;visibility:hidden;pointer-events:none;padding-top:env(safe-area-inset-top,0px)";
            document.documentElement.appendChild(probe);
            const inset = parseFloat(window.getComputedStyle(probe).paddingTop) || 0;
            probe.remove();
            const covered = window.screen.height - window.innerHeight;
            document.documentElement.classList.toggle("ios-pwa-letterbox", inset === 0 && covered >= 20);
          };
          syncIosPwaLetterbox();
          window.addEventListener("DOMContentLoaded", syncIosPwaLetterbox);
          window.addEventListener("orientationchange", () => requestAnimationFrame(syncIosPwaLetterbox));
        }

        // Referral code sharing via Cache Storage (works across Safari <-> PWA on iOS).
        // Canonical key: qadabra_referral_code. Legacy qlarius_referral_code is
        // migrated on read and never written.
        const REFERRAL_ENDPOINT = '/_shared/referral-code';
        const REFERRAL_STORAGE_KEY = 'qadabra_referral_code';
        const REFERRAL_STORAGE_KEY_LEGACY = 'qlarius_referral_code';

        const storeRootReferralCode = (code) => {
          if (!code) return;
          const expires = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toUTCString();
          document.cookie = `${REFERRAL_STORAGE_KEY}=${encodeURIComponent(code)}; expires=${expires}; path=/; SameSite=Lax`;
          try { localStorage.setItem(REFERRAL_STORAGE_KEY, code); } catch (e) {}
          try { localStorage.removeItem(REFERRAL_STORAGE_KEY_LEGACY); } catch (e) {}
          document.cookie = `${REFERRAL_STORAGE_KEY_LEGACY}=; max-age=0; path=/`;
        };

        // Migrate any leftover deprecated storage before other readers run.
        try {
          const legacyLs = localStorage.getItem(REFERRAL_STORAGE_KEY_LEGACY);
          if (legacyLs && !localStorage.getItem(REFERRAL_STORAGE_KEY)) {
            storeRootReferralCode(legacyLs);
          }
        } catch (e) {}
        
        const refParams = new URLSearchParams(window.location.search);
        const refCodeFromUrl = refParams.get('ref') || refParams.get('invite');
        
        // If we have a ref code from URL, store it everywhere
        if (refCodeFromUrl) {
          storeRootReferralCode(refCodeFromUrl);
          
          // Store in Cache Storage via service worker (SHARED between Safari and PWA on iOS!)
          if ('serviceWorker' in navigator) {
            navigator.serviceWorker.ready.then(() => {
              fetch(REFERRAL_ENDPOINT, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ referral_code: refCodeFromUrl })
              }).then(() => {
                console.log('🎯 Referral code saved to shared Cache Storage:', refCodeFromUrl);
              }).catch(e => console.warn('Failed to save referral to cache:', e));
            });
          }
        }
        
        // Try to read referral code from Cache Storage (for PWA opening without URL params)
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.ready.then(() => {
            fetch(REFERRAL_ENDPOINT).then(r => r.json()).then(data => {
              if (data.referral_code) {
                console.log('🎯 Referral code loaded from shared Cache Storage:', data.referral_code);
                storeRootReferralCode(data.referral_code);
                // Dispatch event for any listeners
                window.dispatchEvent(new CustomEvent('referral-code-loaded', { detail: data.referral_code }));
              }
            }).catch(() => {});
          });
        }
        
        const updateThemeColor = (isDark) => {
          const themeColor = isDark ? "#000000" : "#f3f4f6";
          const tags = document.querySelectorAll('meta[name="theme-color"]');
          tags.forEach((tag, index) => {
            if (index === 0) {
              tag.removeAttribute("media");
              tag.setAttribute("content", themeColor);
            } else {
              tag.remove();
            }
          });
          if (tags.length === 0) {
            const metaTag = document.createElement("meta");
            metaTag.setAttribute("name", "theme-color");
            metaTag.setAttribute("content", themeColor);
            document.head.appendChild(metaTag);
          }
        };

        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.setItem("phx:theme", "system");
            const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.setAttribute("data-theme", systemPrefersDark ? "dark" : "light");
            document.documentElement.setAttribute("data-theme-mode", "system");
            updateThemeColor(systemPrefersDark);
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-theme-mode", theme);
            updateThemeColor(theme === "dark");
          }
        };

        // Qlink pages pin "qlink". Widget embeds pin "widget" when a creator
        // or force_theme chooses light or dark. For widget embeds, "system"
        // must follow the viewer device (prefers-color-scheme), not the
        // viewer saved theme.
        const embedDocument = document.documentElement.classList.contains("embed-document");

        const setWidgetSystemTheme = () => {
          const systemPrefersDark =
            window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.setAttribute(
            "data-theme",
            systemPrefersDark ? "dark" : "light"
          );
          document.documentElement.setAttribute("data-theme-mode", "widget-system");
          updateThemeColor(systemPrefersDark);
        };

        const applyThemeForCurrentPath = () => {
          const sp = new URLSearchParams(window.location.search);
          const forceT = sp.get("force_theme");
          const themeMode = document.documentElement.getAttribute("data-theme-mode");
          const qlinkPinned = themeMode === "qlink";
          const widgetPinned = themeMode === "widget";
          const widgetSystem = themeMode === "widget-system";

          if (forceT === "light" || forceT === "dark") {
            document.documentElement.setAttribute("data-theme", forceT);
            document.documentElement.setAttribute(
              "data-theme-mode",
              qlinkPinned ? "qlink" : "forced"
            );
            updateThemeColor(forceT === "dark");
            return;
          }
          if (qlinkPinned) {
            updateThemeColor(
              document.documentElement.getAttribute("data-theme") === "dark"
            );
            return;
          }
          if (widgetPinned) {
            updateThemeColor(
              document.documentElement.getAttribute("data-theme") === "dark"
            );
            return;
          }
          if (widgetSystem || embedDocument) {
            setWidgetSystemTheme();
            return;
          }
          const initial =
            sp.get("theme") || localStorage.getItem("phx:theme") || "system";
          setTheme(initial);
        };

        applyThemeForCurrentPath();

        const shouldIgnoreThemeEvents = () => {
          const sp = new URLSearchParams(window.location.search);
          if (sp.get("force_theme")) return true;

          const mode = document.documentElement.getAttribute("data-theme-mode");
          return mode === "qlink" || mode === "widget";
        };

        const isWidgetSystem = () =>
          document.documentElement.getAttribute("data-theme-mode") === "widget-system" ||
            document.documentElement.classList.contains("embed-document");

        window.addEventListener("storage", (e) => {
          if (e.key !== "phx:theme") return;
          if (shouldIgnoreThemeEvents()) return;
          if (isWidgetSystem()) return;
          setTheme(e.newValue || "system");
        });

        window.addEventListener("phx:set-theme", ({ detail: { theme } }) => {
          if (shouldIgnoreThemeEvents()) return;
          if (isWidgetSystem()) return;
          setTheme(theme);
        });

        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", () => {
            const sp = new URLSearchParams(window.location.search);
            if (sp.get("force_theme")) return;

            const mode = document.documentElement.getAttribute("data-theme-mode");
            if (mode === "widget-system" || document.documentElement.classList.contains("embed-document")) {
              setWidgetSystemTheme();
              return;
            }
            if (mode === "qlink" || mode === "widget") return;

            const current = localStorage.getItem("phx:theme");
            if (!current || current === "system") setTheme("system");
          });

        window.addEventListener("phx:page-loading-stop", applyThemeForCurrentPath);
      })();
    </script>
  </head>
  <body>
    {@inner_content}
    <%!-- Edge-to-edge installs only. A letterboxed icon hides this so it does not cover the title. --%>
    <div class="ios-pwa-status-strip" aria-hidden="true"></div>
  </body>
</html>
