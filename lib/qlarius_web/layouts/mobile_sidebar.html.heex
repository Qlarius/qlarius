<div
  id="sponster-sidebar-bg"
  class="bg-base-300/50 backdrop-blur-xs fixed inset-0 transition-opacity opacity-0 pointer-events-none z-50"
  aria-hidden="true"
/>
<div
  id="sponster-sidebar"
  class="fixed inset-y-0 left-0 z-50 w-80 transform -translate-x-full transition-transform duration-300 ease-in-out surface-panel-fill border-r border-base-content/10 flex flex-col"
  tabindex="1"
  phx-click-away={toggle_sponster_sidebar(:off)}
>
  <%= if assigns[:is_pwa] && assigns[:is_mobile] do %>
    <div class="shrink-0" style="height: max(12px, env(safe-area-inset-top));"></div>
  <% end %>

  <%!-- Profile --%>
  <div class="shrink-0 flex items-start gap-3 px-5 pt-5 pb-3">
    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-base-200">
      <img src="/images/qlarius_logo_squares.svg" class="h-5 w-auto" alt="" />
    </div>
    <div class="min-w-0 flex-1 pt-0.5">
      <div class="font-semibold text-base-content truncate" data-app-target="mobileNumber">
        {@current_scope.user.alias}
      </div>
      <div class="mt-0.5 flex items-center gap-1 text-sm text-base-content/60">
        <.icon name="hero-map-pin" class="h-4 w-4" />
        <span data-app-target="homeZip">{@current_scope.home_zip}</span>
      </div>
    </div>
    <button
      type="button"
      phx-click={toggle_sponster_sidebar(:off)}
      class="shell-menu-close flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-base-200 text-base-content/60 hover:text-base-content cursor-pointer"
      aria-label="Close menu"
    >
      <.icon name="hero-x-mark" class="h-4 w-4" />
    </button>
  </div>

  <%!-- Destinations: the only scroll region in the drawer --%>
  <nav class="flex-1 min-h-0 overflow-y-auto px-3 pb-2" aria-label="Menu">
    <ul class="space-y-0.5">
      <.mobile_menu_item
        navigate={~p"/home"}
        icon="hero-home"
        label="Home"
        active={mobile_menu_active?(assigns[:current_path], "/home")}
      />
      <.mobile_menu_item
        navigate={~p"/wallet"}
        icon="hero-wallet"
        label="Wallet"
        active={mobile_menu_active?(assigns[:current_path], "/wallet")}
      >
        <:trailing>
          <span class="text-sm text-base-content/60 tabular-amount" data-app-target="balance">
            {format_usd(@current_scope.wallet_balance)}
          </span>
        </:trailing>
      </.mobile_menu_item>
      <.mobile_menu_item
        navigate={~p"/qai"}
        icon="hero-sparkles"
        label="Qai"
        active={mobile_menu_active?(assigns[:current_path], "/qai")}
      />
      <.mobile_menu_item
        navigate={~p"/referrals"}
        icon="hero-user-group"
        label="Referrals"
        active={mobile_menu_active?(assigns[:current_path], "/referrals")}
      >
        <:trailing :if={@current_scope.pending_referral_clicks_count > 0}>
          <span class="mobile-menu-count" data-app-target="pendingReferralClicks">
            {@current_scope.pending_referral_clicks_count}
          </span>
        </:trailing>
      </.mobile_menu_item>
    </ul>

    <div class="px-3 pt-5 pb-1.5">
      <img src="/images/YouData_logo_color_horiz.svg" class="h-3.5 w-auto" alt="YouData" />
    </div>
    <ul class="space-y-0.5">
      <.mobile_menu_item
        navigate={~p"/me_file"}
        icon="hero-identification"
        label="MeFile"
        active={mobile_menu_active?(assigns[:current_path], "/me_file")}
      >
        <:trailing>
          <span class="mobile-menu-count" data-app-target="traitCount">
            {@current_scope.trait_count}
          </span>
        </:trailing>
      </.mobile_menu_item>
      <.mobile_menu_item
        navigate={~p"/me_file_builder"}
        icon="hero-wrench-screwdriver"
        label="Builder"
        active={mobile_menu_active?(assigns[:current_path], "/me_file_builder")}
      />
    </ul>

    <div class="px-3 pt-5 pb-1.5">
      <img src="/images/Sponster_logo_color_horiz.svg" class="h-3.5 w-auto" alt="Sponster" />
    </div>
    <ul class="space-y-0.5">
      <.mobile_menu_item
        navigate={~p"/ads"}
        icon="hero-eye"
        label="Ads"
        active={mobile_menu_active?(assigns[:current_path], "/ads")}
      >
        <:trailing>
          <span class="mobile-menu-count" data-app-target="offerCount">
            {@current_scope.ads_count}
          </span>
        </:trailing>
      </.mobile_menu_item>
    </ul>

    <div class="px-3 pt-5 pb-1.5">
      <img src="/images/Tiqit_logo_color_horiz.svg" class="h-3.5 w-auto" alt="Tiqit" />
    </div>
    <ul class="space-y-0.5">
      <.mobile_menu_item
        navigate={~p"/tiqits"}
        icon="hero-ticket"
        label="Stash"
        active={mobile_menu_active?(assigns[:current_path], "/tiqits")}
      >
        <:trailing :if={@current_scope && @current_scope.active_tiqit_count > 0}>
          <span class="mobile-menu-count">{@current_scope.active_tiqit_count}</span>
        </:trailing>
      </.mobile_menu_item>
      <.mobile_menu_item
        navigate={~p"/arqade"}
        icon="hero-play-circle"
        label="Arqade"
        active={mobile_menu_active?(assigns[:current_path], "/arqade")}
      />
    </ul>
  </nav>

  <%!-- Appearance, settings, log out --%>
  <div
    class="shrink-0 border-t border-base-content/10 px-3 pt-2"
    style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
  >
    <div class="flex items-center justify-between h-11 px-3 text-[15px] font-medium text-base-content">
      <span>Appearance</span>
      <Layouts.theme_toggle />
    </div>
    <ul class="space-y-0.5">
      <.mobile_menu_item
        navigate={~p"/settings"}
        icon="hero-cog-6-tooth"
        label="Settings"
        active={mobile_menu_active?(assigns[:current_path], "/settings")}
      />
      <li>
        <button
          type="button"
          phx-click="show_logout_modal"
          class="flex w-full items-center gap-3.5 h-11 px-3 rounded-xl text-[15px] font-medium text-base-content/70 hover:bg-base-200/70 cursor-pointer"
        >
          <.icon
            name="hero-arrow-right-on-rectangle"
            class="h-[22px] w-[22px] shrink-0 text-base-content/60"
          /> Log out
        </button>
      </li>
    </ul>
  </div>
</div>
