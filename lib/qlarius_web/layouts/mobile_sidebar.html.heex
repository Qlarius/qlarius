<div
  id="sponster-sidebar-bg"
  class="bg-base-300/50 backdrop-blur-xs fixed inset-0 transition-opacity opacity-0 pointer-events-none z-50"
  aria-hidden="true"
/>
<div
  id="sponster-sidebar"
  class="fixed inset-y-0 left-0 z-50 w-80 transform -translate-x-full transition-transform duration-300 ease-in-out surface-panel-fill border-r border-base-content/10 flex flex-col"
  tabindex="1"
  phx-click-away={toggle_sponster_sidebar(:off)}
>
  <%= if assigns[:is_pwa] && assigns[:is_mobile] do %>
    <div class="shrink-0" style="height: max(12px, env(safe-area-inset-top));"></div>
  <% end %>

  <%!-- Profile --%>
  <div class="shrink-0 flex items-start gap-3 px-5 pt-5 pb-3">
    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-base-200">
      <img src="/images/qadabra_logo_squares_color.svg" class="h-6 w-auto" alt="" />
    </div>
    <div class="min-w-0 flex-1 pt-0.5">
      <div class="font-semibold leading-snug text-base-content break-words">
        {@current_scope.user.alias}
      </div>
      <div class="mt-0.5 flex items-center gap-1 text-sm text-base-content/60">
        <.icon name="hero-map-pin" class="h-4 w-4" />
        <span>{@current_scope.home_zip}</span>
      </div>
    </div>
    <button
      type="button"
      phx-click={toggle_sponster_sidebar(:off)}
      class="shell-menu-close flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-base-200 text-base-content/60 hover:text-base-content cursor-pointer"
      aria-label="Close menu"
    >
      <.icon name="hero-x-mark" class="h-4 w-4" />
    </button>
  </div>

  <%!-- Everyday places, then one card per product. The only scroll region in the drawer. --%>
  <nav class="flex-1 min-h-0 overflow-y-auto px-3 pb-3 flex flex-col gap-2.5" aria-label="Menu">
    <div class="grid grid-cols-3 gap-2">
      <.mobile_menu_tile
        navigate={~p"/home"}
        icon="hero-home"
        label="Home"
        active={mobile_menu_active?(assigns[:current_path], "/home")}
      />
      <.mobile_menu_tile
        navigate={~p"/wallet"}
        icon="hero-wallet"
        label="Wallet"
        meta={format_usd(@current_scope.wallet_balance)}
        active={mobile_menu_active?(assigns[:current_path], "/wallet")}
      />
      <.mobile_menu_tile
        navigate={~p"/qai"}
        image="/images/qai_logo_image.svg"
        label="Qai"
        meta="Ask anything"
        active={mobile_menu_active?(assigns[:current_path], "/qai")}
      />
    </div>

    <.mobile_menu_brand
      logo="/images/YouData_logo_color_horiz.svg"
      name="YouData"
      tagline="Own your data."
      color="var(--color-youdata-500)"
    >
      <.mobile_menu_tile
        navigate={~p"/me_file"}
        icon="hero-identification"
        label="MeFile"
        meta={"#{@current_scope.trait_count || 0} #{if @current_scope.trait_count == 1, do: "tag", else: "tags"}"}
        active={mobile_menu_active?(assigns[:current_path], "/me_file")}
        branded
      />
      <.mobile_menu_tile
        navigate={~p"/me_file_builder"}
        icon="hero-wrench-screwdriver"
        label="Builder"
        meta="Add tags"
        active={mobile_menu_active?(assigns[:current_path], "/me_file_builder")}
        branded
      />
    </.mobile_menu_brand>

    <.mobile_menu_brand
      logo="/images/Sponster_logo_color_horiz.svg"
      name="Sponster"
      tagline="Sell your attention."
      color="var(--color-sponster-500)"
    >
      <.mobile_menu_tile
        navigate={~p"/ads"}
        icon="hero-play"
        label="Ads"
        meta={"#{@current_scope.ads_count || 0} · #{format_usd(@current_scope.offered_amount)}"}
        active={mobile_menu_active?(assigns[:current_path], "/ads")}
        branded
      />
      <.mobile_menu_tile
        navigate={~p"/referrals"}
        icon="hero-user-group"
        label="Referrals"
        meta={
          if (@current_scope.pending_referral_clicks_count || 0) > 0,
            do: "#{@current_scope.pending_referral_clicks_count} new",
            else: "Invite friends"
        }
        active={mobile_menu_active?(assigns[:current_path], "/referrals")}
        branded
      />
    </.mobile_menu_brand>

    <.mobile_menu_brand
      logo="/images/Tiqit_logo_color_horiz.svg"
      name="Tiqit"
      tagline="Buy your media."
      color="var(--color-tiqit-500)"
      chip_color="var(--color-tiqit-600)"
    >
      <.mobile_menu_tile
        navigate={~p"/tiqits"}
        icon="hero-ticket"
        label="Stash"
        meta={"#{@current_scope.active_tiqit_count || 0} active"}
        active={mobile_menu_active?(assigns[:current_path], "/tiqits")}
        branded
      />
      <.mobile_menu_tile
        navigate={~p"/arqade"}
        icon="hero-play-circle"
        label="Arqade"
        meta="Browse"
        active={mobile_menu_active?(assigns[:current_path], "/arqade")}
        branded
      />
    </.mobile_menu_brand>
  </nav>

  <%!-- Appearance, settings in the center, log out --%>
  <div
    class="shrink-0 border-t border-base-content/10 px-4 pt-2.5 grid grid-cols-[1fr_auto_1fr] items-center"
    style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
  >
    <div class="justify-self-start">
      <Layouts.theme_toggle />
    </div>
    <.link
      navigate={~p"/settings"}
      aria-label="Settings"
      aria-current={mobile_menu_active?(assigns[:current_path], "/settings") && "page"}
      class={[
        "flex size-9 items-center justify-center rounded-full border-2",
        if(mobile_menu_active?(assigns[:current_path], "/settings"),
          do: "border-primary/30 bg-primary/15 text-primary",
          else: "border-base-300 bg-base-300 text-base-content [&>span]:opacity-75 hover:[&>span]:opacity-100"
        )
      ]}
    >
      <.icon name="hero-cog-6-tooth-micro" class="size-4" />
    </.link>
    <button
      type="button"
      phx-click="show_logout_modal"
      class="justify-self-end inline-flex h-9 items-center gap-1.5 rounded-full border-2 border-base-300 bg-base-300 px-3 text-sm font-medium text-base-content/75 hover:text-base-content cursor-pointer"
    >
      <.icon name="hero-arrow-right-start-on-rectangle-micro" class="size-4" /> Log out
    </button>
  </div>
</div>
