<Layouts.admin {assigns}>
  <div class="flex h-screen">
    <AdminSidebar.sidebar current_user={@current_scope.user} current_path={@current_path} />

    <div class="flex min-w-0 grow flex-col">
      <AdminTopbar.topbar current_user={@current_scope.user} />

      <div class="overflow-auto">
        <.page class="max-w-4xl">
          <.page_header
            title={
              if @live_action == :edit,
                do: "Edit #{Catalog.type_label(@catalog.group_type, 1, capitalize: false)}",
                else: "New #{Catalog.type_label(@catalog.group_type, 1, capitalize: false)}"
            }
            subtitle={if @live_action == :edit, do: @group.title, else: "In #{@catalog.name}"}
            crumbs={@crumbs}
          />

          <.form
            for={@form}
            id="content-group-form"
            phx-change="validate"
            phx-submit="save"
            class="space-y-6"
          >
            <.panel
              id="group-details-section"
              title="Details"
              description={"How this #{Catalog.type_label(@catalog.group_type, 1, capitalize: false)} is introduced to viewers."}
            >
              <.input
                field={@form[:title]}
                type="text"
                label="Name"
                placeholder={"#{Catalog.type_label(@catalog.group_type)} name"}
                required
              />
              <.input
                field={@form[:description]}
                type="textarea"
                label="Description"
                placeholder="What is it about?"
                rows="4"
              />
              <.image_upload_field
                upload={@uploads.image}
                label="Image"
                current_image={@group.image}
                current_image_url={
                  if @group.image,
                    do: QlariusWeb.Uploaders.CreatorImage.url({@group.image, @group}, :original)
                }
                on_delete="delete_image"
              />
            </.panel>

            <.panel
              id="group-display-section"
              title="Display options"
              description={"How the #{Catalog.type_label(@catalog.piece_type, 2, capitalize: false)} list looks in the player."}
              flush
            >
              <div class="divide-y divide-base-300">
                <.toggle_row
                  field={@form[:show_piece_thumbnails]}
                  label={"Show #{Catalog.type_label(@catalog.piece_type, 1, capitalize: false)} thumbnails"}
                  description={"Show a thumbnail image next to each #{Catalog.type_label(@catalog.piece_type, 1, capitalize: false)}."}
                />
                <.toggle_row
                  field={@form[:show_piece_descriptions]}
                  label={"Show #{Catalog.type_label(@catalog.piece_type, 1, capitalize: false)} descriptions"}
                  description={"Show each #{Catalog.type_label(@catalog.piece_type, 1, capitalize: false)}'s description in the list."}
                />
                <.toggle_row
                  field={@form[:show_open_in_tab]}
                  label={"Show \"Open in new tab\" button"}
                  description="When the player is embedded in an iframe, show an icon that opens it in a new browser tab."
                />
              </div>
            </.panel>

            <.panel
              id="group-pricing-section"
              title={"#{Catalog.type_label(@catalog.group_type)} pass"}
              description={"Access to every #{Catalog.type_label(@catalog.piece_type, 1, capitalize: false)} in this #{Catalog.type_label(@catalog.group_type, 1, capitalize: false)} for a set time."}
            >
              <:actions>
                <button
                  :if={@live_action == :edit}
                  type="button"
                  phx-click="write_default_tiqit_classes"
                  class="btn btn-ghost btn-sm"
                >
                  <.icon name="hero-plus" class="size-4" /> Add default classes
                </button>
              </:actions>
              <TiqitClassHTML.inputs_for_tiqit_classes form={@form} />
            </.panel>

            <.save_bar dirty={false}>
              <.link
                navigate={
                  if @live_action == :edit,
                    do: ~p"/creators/content_groups/#{@group.id}",
                    else: ~p"/creators/catalogs/#{@catalog.id}"
                }
                class="btn btn-ghost"
              >
                Cancel
              </.link>
              <.button variant="primary" phx-disable-with="Saving…">
                {if @live_action == :edit,
                  do: "Save #{Catalog.type_label(@catalog.group_type, 1, capitalize: false)}",
                  else: "Create #{Catalog.type_label(@catalog.group_type, 1, capitalize: false)}"}
              </.button>
            </.save_bar>
          </.form>
        </.page>
      </div>
    </div>
  </div>
</Layouts.admin>
