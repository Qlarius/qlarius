<Layouts.admin {assigns}>
  <div class="flex h-screen">
    <AdminSidebar.sidebar current_user={@current_scope.user} />

    <div class="flex min-w-0 grow flex-col">
      <AdminTopbar.topbar current_user={@current_scope.user} />

      <div class="overflow-auto">
        <.page class="max-w-4xl">
          <.page_header
            title={
              if @live_action == :edit,
                do: "Edit #{Catalog.type_label(@catalog.type, 1, capitalize: false)}",
                else: "New catalog"
            }
            subtitle={if @live_action == :edit, do: @catalog.name, else: "For #{@creator.name}"}
            crumbs={
              if @live_action == :edit,
                do: [
                  {@creator.name, ~p"/creators/#{@creator.id}"},
                  {@catalog.name, ~p"/creators/catalogs/#{@catalog.id}"}
                ],
                else: [{@creator.name, ~p"/creators/#{@creator.id}"}]
            }
          />

          <.form
            for={@form}
            id="catalog-form"
            phx-change="validate"
            phx-submit="save"
            class="space-y-6"
          >
            <.panel title="Details" description="The name, website and cover image people see.">
              <.image_upload_field
                upload={@uploads.image}
                label="Image"
                current_image={@catalog.image}
                current_image_url={
                  if @catalog.image,
                    do:
                      QlariusWeb.Uploaders.CreatorImage.url(
                        {@catalog.image, @catalog},
                        :original
                      )
                }
                on_delete="delete_image"
              />

              <div class="grid gap-4 sm:grid-cols-2">
                <.input
                  field={@form[:name]}
                  type="text"
                  label="Name"
                  placeholder="e.g. Claire Saffitz Studios"
                  required
                />
                <.input
                  field={@form[:url]}
                  type="url"
                  label="URL"
                  placeholder="https://example.com"
                  required
                />
              </div>
            </.panel>

            <.panel
              title="Structure"
              description="What you call each level. These labels are used across your Tiqit pages."
            >
              <div class="grid gap-4 sm:grid-cols-3">
                <.input
                  field={@form[:type]}
                  type="select"
                  label="Catalog type"
                  options={type_options(Catalog.types())}
                  required
                />
                <.input
                  field={@form[:group_type]}
                  type="select"
                  label="Group type"
                  options={type_options(Catalog.group_types())}
                  required
                />
                <.input
                  field={@form[:piece_type]}
                  type="select"
                  label="Piece type"
                  options={type_options(Catalog.piece_types())}
                  required
                />
              </div>
              <p class="flex items-center gap-2 rounded-lg bg-base-200/40 px-3 py-2 text-sm">
                <.icon name="hero-squares-2x2" class="size-4 text-base-content/50" />
                <span class="text-base-content/60">Structure:</span>
                <span class="font-medium">{structure_preview(@form)}</span>
              </p>
            </.panel>

            <.panel title="Tiqit policies" description="Refund and upgrade rules for your buyers.">
              <.input
                field={@form[:tiqit_undo_limit]}
                type="number"
                label="Undo limit per consumer"
                placeholder="Unlimited"
                min="3"
                description="How many times each consumer can undo (refund) a tiqit purchase with you. Minimum 3 if set. Leave blank for unlimited (no tracking)."
              />

              <div>
                <.input field={@form[:tiqit_up_enabled]} type="checkbox" label="Enable Tiqit Up" />
                <p class="text-sm text-base-content/60">
                  Consumers who buy individual {type_word(
                    @form,
                    :piece_type,
                    Catalog.piece_types(),
                    2
                  )} get credit toward {type_word(
                    @form,
                    :group_type,
                    Catalog.group_types()
                  )} or {type_word(@form, :type, Catalog.types())} purchases. This reduces friction and rewards exploration.
                </p>
              </div>
            </.panel>

            <.panel
              title={"#{Catalog.type_label(selected_type(@form, :type, Catalog.types()))} pass pricing"}
              description={"Timed access to everything in this #{type_word(@form, :type, Catalog.types())}."}
            >
              <:actions :if={@live_action == :edit}>
                <button
                  type="button"
                  phx-click="write_default_tiqit_classes"
                  class="btn btn-ghost btn-sm"
                >
                  <.icon name="hero-plus" class="size-4" /> Add default classes
                </button>
              </:actions>
              <TiqitClassHTML.inputs_for_tiqit_classes form={@form} />
            </.panel>

            <.save_bar dirty={false}>
              <.link
                navigate={
                  if @live_action == :edit,
                    do: ~p"/creators/catalogs/#{@catalog.id}",
                    else: ~p"/creators/#{@creator.id}"
                }
                class="btn btn-ghost"
              >
                Cancel
              </.link>
              <.button variant="primary" phx-disable-with="Saving…">
                {if @live_action == :edit, do: "Save changes", else: "Create catalog"}
              </.button>
            </.save_bar>
          </.form>
        </.page>
      </div>
    </div>
  </div>
</Layouts.admin>
