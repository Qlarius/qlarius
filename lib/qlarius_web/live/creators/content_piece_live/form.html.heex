<Layouts.admin {assigns}>
  <div class="flex h-screen">
    <AdminSidebar.sidebar current_user={@current_scope.user} />

    <div class="flex min-w-0 grow flex-col">
      <AdminTopbar.topbar current_user={@current_scope.user} />

      <div class="overflow-auto">
        <.page class="max-w-4xl">
          <.page_header
            title={
              if @live_action == :edit,
                do: "Edit #{Catalog.type_label(@catalog.piece_type, 1, capitalize: false)}",
                else: "New #{Catalog.type_label(@catalog.piece_type, 1, capitalize: false)}"
            }
            subtitle={if @live_action == :edit, do: @piece.title, else: "In #{@group.title}"}
            crumbs={
              [
                {@creator.name, ~p"/creators/#{@creator.id}"},
                {@catalog.name, ~p"/creators/catalogs/#{@catalog.id}"},
                {@group.title, ~p"/creators/content_groups/#{@group.id}"}
              ] ++
                if(@live_action == :edit,
                  do: [{@piece.title, ~p"/creators/content_pieces/#{@piece.id}"}],
                  else: []
                )
            }
          />

          <.form
            for={@form}
            id="content-piece-form"
            phx-change="validate"
            phx-submit="save"
            class="space-y-6"
          >
            <.panel
              id="piece-details-section"
              title="Details"
              description={"What viewers see for this #{Catalog.type_label(@catalog.piece_type, 1, capitalize: false)}."}
            >
              <div class="grid gap-x-4 sm:grid-cols-[minmax(0,1fr)_14rem]">
                <.input
                  field={@form[:title]}
                  type="text"
                  label="Title"
                  placeholder={"#{Catalog.type_label(@catalog.piece_type)} title"}
                  required
                />
                <.input
                  field={@form[:date_published]}
                  type="date"
                  label="Published date"
                  required
                />
              </div>
              <.input
                field={@form[:description]}
                type="textarea"
                label="Description"
                placeholder="What is it about?"
                rows="4"
              />
              <.image_upload_field
                upload={@uploads.image}
                label="Image"
                current_image={@piece.image}
                current_image_url={
                  if @piece.image,
                    do: QlariusWeb.Uploaders.CreatorImage.url({@piece.image, @piece}, :original)
                }
                on_delete="delete_image"
              />
            </.panel>

            <.panel
              id="piece-access-section"
              title="Access exclusions"
              description={"Opt this #{Catalog.type_label(@catalog.piece_type, 1, capitalize: false)} out of broader passes so buyers must purchase it separately."}
              flush
            >
              <div class="divide-y divide-base-300">
                <.toggle_row
                  field={@form[:exclude_from_catalog_access]}
                  label={"Exclude from #{Catalog.type_label(@catalog.type, 1, capitalize: false)} pass"}
                  description={"Not included when someone buys a #{Catalog.type_label(@catalog.type, 1, capitalize: false)} pass."}
                />
                <.toggle_row
                  field={@form[:exclude_from_group_access]}
                  label={"Exclude from #{Catalog.type_label(@catalog.group_type, 1, capitalize: false)} pass"}
                  description={"Not included when someone buys a #{Catalog.type_label(@catalog.group_type, 1, capitalize: false)} pass."}
                />
              </div>
            </.panel>

            <.panel
              id="piece-pricing-section"
              title={"#{Catalog.type_label(@catalog.piece_type)} pricing"}
              description={"Buy just this #{Catalog.type_label(@catalog.piece_type, 1, capitalize: false)}. Each row sets how long access lasts and what it costs."}
            >
              <:actions>
                <button
                  :if={@live_action == :edit}
                  type="button"
                  phx-click="write_default_tiqit_classes"
                  class="btn btn-ghost btn-sm"
                >
                  <.icon name="hero-plus" class="size-4" /> Add default classes
                </button>
              </:actions>
              <TiqitClassHTML.inputs_for_tiqit_classes form={@form} />
            </.panel>

            <.save_bar dirty={false}>
              <.link navigate={~p"/creators/content_groups/#{@group.id}"} class="btn btn-ghost">
                Cancel
              </.link>
              <.button variant="primary" phx-disable-with="Saving…">
                {if @live_action == :edit,
                  do: "Save #{Catalog.type_label(@catalog.piece_type, 1, capitalize: false)}",
                  else: "Create #{Catalog.type_label(@catalog.piece_type, 1, capitalize: false)}"}
              </.button>
            </.save_bar>
          </.form>
        </.page>
      </div>
    </div>
  </div>
</Layouts.admin>
